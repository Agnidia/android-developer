{
  "name": "android-developer",
  "description": "Android development toolkit for Claude Code: agents, skills, and commands for Kotlin, Jetpack Compose, and Gradle, with corpflow pipeline integration, scoped Bash toolchain allowlists (gradle/adb/ktlint/detekt), qualified Task() delegation, and plugin-scoped audit and checkpoint hooks.",
  "version": "1.5.1",
  "author": {
    "name": "IGRSoft",
    "email": "support@igrsoft.com"
  },
  "license": "Apache-2.0",
  "keywords": [
    "android",
    "kotlin",
    "jetpack-compose",
    "compose",
    "material3",
    "gradle",
    "hilt",
    "coroutines",
    "flow",
    "room",
    "retrofit",
    "datastore",
    "clean-architecture",
    "mvvm",
    "mvi",
    "modularization",
    "ktlint",
    "detekt",
    "junit",
    "mockk",
    "turbine",
    "roborazzi",
    "r8",
    "proguard",
    "adb",
    "version-catalogs",
    "release-engineering",
    "context-efficiency",
    "hooks",
    "subagent-lifecycle",
    "qualified-agent-refs",
    "pre-compact",
    "max-turns",
    "disallowed-tools",
    "cli-fallback-evidence"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|TaskUpdate|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": [
              "--kind",
              "tool"
            ],
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
