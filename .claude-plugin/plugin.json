{
  "name": "android-developer",
  "description": "Android development toolkit with specialized agents for Kotlin, Jetpack Compose, and Gradle. Full igrsoft 11-stage workflow integration (PL→AR→TL→DV→DR→SR→QA→DC→RE→FN→ST): handoff-protocol (development-N.md, state.json, frontmatter schema), requires_screenshots:false / cli-fallback evidence norm, scoped Bash toolchain allowlists (gradle/adb/ktlint/detekt), qualified Task() delegation, and plugin-scoped audit/checkpoint hooks.",
  "version": "1.3.0",
  "author": {
    "name": "IGRSoft",
    "email": "support@igrsoft.com"
  },
  "license": "Apache-2.0",
  "keywords": [
    "android", "kotlin", "jetpack-compose", "compose", "material3", "gradle",
    "hilt", "coroutines", "flow", "room", "retrofit", "datastore",
    "clean-architecture", "mvvm", "mvi", "modularization",
    "ktlint", "detekt", "junit", "mockk", "turbine", "roborazzi",
    "r8", "proguard", "adb", "version-catalogs",
    "workflow-integration", "developer-review", "dr-stage", "security-review",
    "release-engineering", "context-efficiency", "hooks", "subagent-lifecycle",
    "qualified-agent-refs", "pre-compact", "max-turns", "disallowed-tools",
    "cli-fallback-evidence"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|TaskUpdate|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": ["--kind", "tool"],
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
